# Skopiuj ten plik jako .env i uzupełnij WSZYSTKIE wartości. Plik .env NIE trafia do repozytorium.
# Wszystkie zmienne są wymagane - gdy którejkolwiek brakuje, testy nie zostaną uruchomione.

# Klucz API OpenWeatherMap (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Bazowy adres API, np. https://api.openweathermap.org
OPENWEATHER_BASE_URL=

# Timeout żądania w sekundach, np. 10
REQUEST_TIMEOUT=
